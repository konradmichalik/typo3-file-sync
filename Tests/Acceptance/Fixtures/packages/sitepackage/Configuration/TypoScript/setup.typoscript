page = PAGE
page {
    typeNum = 0

    10 = FLUIDTEMPLATE
    10 {
        templateName = Default
        templateRootPaths.10 = EXT:sitepackage/Resources/Private/Templates/Page/
        layoutRootPaths.10 = EXT:sitepackage/Resources/Private/Layouts/Page/
        partialRootPaths.10 = EXT:sitepackage/Resources/Private/Partials/

        # variables.content already renders colPos=0 as HTML the same way
        # styles.content.get always has; a DatabaseQueryProcessor assigning
        # its own raw tt_content rows to a variable of the same name used to
        # sit here too, and FLUIDTEMPLATE resolved that one last, handing
        # Page/Default.html's <f:format.raw>{content}</f:format.raw> an array
        # instead of a string. Never caught, because nothing rendered this
        # template until the default sys_template TYPO3's own `setup
        # --create-site` installs was removed from the database.
        variables {
            content < styles.content.get
        }
    }
}
