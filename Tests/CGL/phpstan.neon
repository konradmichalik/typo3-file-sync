includes:
	- %rootDir%/../../konradmichalik/phpstan-typo3-preset/phpstan.neon.dist
	- phpstan-baseline.neon

parameters:
	level: 8

	typo3:
		requestGetAttributeMapping:
			backend.user: TYPO3\CMS\Core\Authentication\BackendUserAuthentication

	scanDirectories:
		- ../../vendor
	paths:
		- ../../Classes
		- ../../Configuration
		- ../../Resources
		- ../../Tests/Unit

	excludePaths:
		- ../../.Build (?)

	type_coverage:
		constant: 0 # TODO: Set to 100, when PHP 8.3 is minimum requirement
