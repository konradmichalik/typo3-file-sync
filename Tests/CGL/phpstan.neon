includes:
	- %rootDir%/../../konradmichalik/phpstan-typo3-preset/phpstan.neon.dist
	- phpstan-baseline.neon

parameters:
	level: 8

	typo3:
		requestGetAttributeMapping:
			backend.user: TYPO3\CMS\Core\Authentication\BackendUserAuthentication

	scanDirectories:
		- ../../vendor
	scanFiles:
		# Test support Tests/Unit uses without being analysed itself. Named
		# one by one rather than by directory, so that neither the fixture
		# extensions nor Tests/CGL/vendor is pulled into every run.
		- ../../Tests/StoredPreview.php

	paths:
		- ../../Classes
		- ../../Configuration
		- ../../Resources
		- ../../Tests/Unit

	excludePaths:
		- ../../.Build (?)

	type_coverage:
		constant: 0 # TODO: Set to 100, when PHP 8.3 is minimum requirement
